#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage:"
  echo "  ${0##*/} URL"
  exit 1
}

if (($# != 1)); then
  usage
fi

URL="$1"

yt-dlp \
  -f "bv*[height<=1080][vcodec^=avc1][ext=mp4]+ba[acodec^=mp4a][ext=m4a]" \
  --merge-output-format mp4 \
  --embed-metadata \
  --restrict-filenames \
  "$URL"
